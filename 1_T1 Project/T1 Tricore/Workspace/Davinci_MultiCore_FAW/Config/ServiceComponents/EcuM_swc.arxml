                      </POSSIBLE-ERROR-REFS>
                    </CLIENT-SERVER-OPERATION>
                    <CLIENT-SERVER-OPERATION UUID="876a58fc-56bd-4253-bf15-5e856f392b1f">
                      <SHORT-NAME>GetShutdownCause</SHORT-NAME>
                      <DESC>
                        <L-2 L="FOR-ALL">Returns the selected shutdown cause as set by the operation SelectShutdownCause.</L-2>
                      </DESC>
                      <ARGUMENTS>
                        <ARGUMENT-DATA-PROTOTYPE UUID="8e1a7e69-5265-40cb-8e77-e1737d66d462">

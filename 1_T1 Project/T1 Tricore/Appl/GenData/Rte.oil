      PRIORITY = 90:"@RO@";
      SCHEDULE = FULL:"@RO@";
// TIMING_PROTECTION = FALSE|TRUE; (AUTOSAR OS only)
      AUTOSTART = FALSE:"@RO@";
      ACCESSING_APPLICATION = OsApplication_Core0;
      ACCESSING_APPLICATION = OsApplication_Core1;
   }:"@RO@@NR@";

   ALARM Rte_Al_TE3_EcuM_EcuM_MainFunction {
      COUNTER = SystemTimer_Core2;
      ACTION = ACTIVATETASK
      {
         TASK = TaskSchM_Core2;
      }:"@ROC@";
      AUTOSTART = FALSE:"@RO@";
      ACCESSING_APPLICATION = OsApplication_Core0;
      ACCESSING_APPLICATION = OsApplication_Core1;
   }:"@RO@@NR@";

   EVENT Rte_Ev_Cyclic2_TaskSchM_Core0_0_10ms {
      MASK = AUTO;
   }:"@ROC@@NR@";

   EVENT Rte_Ev_Cyclic2_TaskSchM_Core0_0_20ms {
      MASK = AUTO;
   }:"@ROC@@NR@";



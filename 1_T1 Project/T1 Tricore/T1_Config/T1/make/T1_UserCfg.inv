; Relative file paths are based on the directory ABOVE T1_projGen.bat

-inlineHeader=..\src\T1_AppInterface.h          ; name and path for in-lining T1_AppInterface.h into T1 project file
-configHeader=..\src\T1_config.h                ; name and path of T1_config.h being generated
-configGenC=..\src\T1_configGen.c               ; name and path of T1_configGen.c being generated
;-bidHeader=..\src\T1_bid.h                     ; name and path of generated header file containing T1 Build ID (which is then excluded from T1_config.h)
;-runnableHeader=..\src\T1_runnables.h          ; name and path of generated header file containing runnable IDs (and wrappers if supported by OS-script)
-projectFile=..\T1_project.t1p                  ; name and path of T1 project file being generated
-symbolFile=myProjectFolder\test.elf            ; name and path of symbol-file
-projectName=customer T1 project                ; project name meaningful to customer
-licInfo1=POT1475                               ; project and license information for GLIWA
-licInfo2=LicID0688                             ; project and license information for GLIWA
-storeTimingInformation=false                   ; store timing information in T1 project file (e.g. for being used in T1.diff) [true/false]
-initFeatureMask=0                              ; init value for application feature maskT1_AF_TRACE_STARTUP| T1_AF_ALLOW_TRIGGER
;-targetExcludeFromTraceByName=myTask1          ; exclude task from tracing. Only allowed for the group of tasks at the lowest used priority level! ( using macro T1_TRACE_TASK) [optional]
-staticRunnableID=1023                          ; define the value of the static runnable ID [0..1023]

#system 0:
-systemName=Core0                               ; any system name being displayed in T1.base menu in T1-HOST-SW
-systemComment=Core0                            ; any system comment
-osBasicSchedFrameName=Task100ms_Core0           ; basicSchedulingFrameEvent: OS-name of periodic task containing the main control or calculations of the system
;-osBackgroundTaskName=IdleTask_OsCore0         ; task to be excluded from T1.cont and T1.scope CPU-load calculation [OS-name] [optional]
-traceBufferEntries=4000                        ; trace buffer entries
-analysisCapacity=1000                          ; T1.cont analysis capacity (number of events being analysed during one call to T1.cont BG handler)
;-flexAnalysisCapacity=2000                     ; maximum allowed number of T1.flex exception handler calls between two T1_Handler calls.
-cpuLoadThreshold=95                            ; CPU-load threshold for T1.cont CPU-load callback [0..99]
-numberOfConstraints=2                          ; number of T1.cont constraints

#system 1:
-systemName=Core1                               ; any system name being displayed in T1.base menu in T1-HOST-SW
-systemComment=Core1                            ; any system comment
-osBasicSchedFrameName=Task100ms_Core1           ; basicSchedulingFrameEvent: OS-name of periodic task containing the main control or calculations of the system
;-osBackgroundTaskName=IdleTask_OsCore1            ; task to be excluded from T1.cont and T1.scope CPU-load calculation [OS-name] [optional]
-traceBufferEntries=4000                        ; trace buffer entries
-analysisCapacity=1000                          ; T1.cont analysis capacity (number of events being analysed during one call to T1.cont BG handler)
;-flexAnalysisCapacity=2000                     ; maximum allowed number of T1.flex exception handler calls between two T1_Handler calls.
-cpuLoadThreshold=95                            ; CPU-load threshold for T1.cont CPU-load callback [0..99]
-numberOfConstraints=2                          ; number of T1.cont constraints

#system 2:
-systemName=Core2                               ; any system name being displayed in T1.base menu in T1-HOST-SW
-systemComment=Core2                            ; any system comment
-osBasicSchedFrameName=Task100ms_Core2           ; basicSchedulingFrameEvent: OS-name of periodic task containing the main control or calculations of the system
;-osBackgroundTaskName=IdleTask_OsCore2            ; task to be excluded from T1.cont and T1.scope CPU-load calculation [OS-name] [optional]
-traceBufferEntries=4000                        ; trace buffer entries
-analysisCapacity=1000                          ; T1.cont analysis capacity (number of events being analysed during one call to T1.cont BG handler)
;-flexAnalysisCapacity=2000                     ; maximum allowed number of T1.flex exception handler calls between two T1_Handler calls.
-cpuLoadThreshold=95                            ; CPU-load threshold for T1.cont CPU-load callback [0..99]
-numberOfConstraints=2                          ; number of T1.cont constraints

    CTYPE "Os_TickType" CYCLETIME, "Cycle Time (Ticks)";
    ENUM "unsigned char" [
      "ALRM_CB" = 3,
      "ALRM_IC" = 2,
      "ALRM_SE" = 1,
      "ALRM_AT" = 0
     ] vs_Action, "Alarm Action";
    STRING COUNTER, "Counter";
  }, "Alarms"; /* ALARM */

EVENT {
    CTYPE "EventMaskType" vs_EventMask, "Event Mask";
  }, "Events"; /* EVENT */

RESOURCE {
    ENUM "unsigned char" [
      "LOCKED" = 1,
      "RELEASED" = 0
     ] vs_STATE, "Resource State";
    ENUM "unsigned char" [
      "ISR" = 1,
      "TASK" = 0
     ] TYPE, "Resource Type";
  }, "Resources";  /* RESOURCE */

SPINLOCK {
    ENUM "unsigned char" [
      "LOCKED" = 1,
      "UNLOCKED" = 0
     ] vs_STATE, "Spinlock State";
    ENUM "unsigned char" [
      "SCHEDULER" = 3,
      "CAT2_ISR" = 2,
      "ALL_ISR" = 1,
      "NOTHING" = 0
     ] vs_Method, "Spinlock Method";
  }, "Spinlocks";  /* SPINLOCK */

SCHEDULETABLE {
    ENUM "ScheduleTableStatusType" [
      "STOPPED" = 0,
      "NEXT" = 1,
      "WAITING" = 2,
      "RUNNING" = 3,
      "RUNNING_AND_SYNCHRONOUS" = 4
    ] vs_STATE, "State";
    ENUM "void *" [
      "-" = "0x0"
    ] vs_ScheduleTableNext, "Next ScheduleTable";
    ENUM "void *" [
      "-" = "0x0"
    ] vs_ExpiryPointCurrent, "current Expiry Point";
  }, "ScheduleTables"; /* SCHEDULETABLE */

CPULOAD{
  CTYPE "uint32" vs_Runtime, "RunTime";
  CTYPE "uint32" vs_Cpuload, "CpuLoad";
},"Cpuload";/* CPULOAD */
}


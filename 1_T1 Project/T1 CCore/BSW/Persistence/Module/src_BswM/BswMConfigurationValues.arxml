                                                            <SHORT-NAME>BswMUserCallout</SHORT-NAME>
                                                            <IMPORT>NONE</IMPORT>
                                                            <SOURCE-FILE></SOURCE-FILE>
                                                            <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/AUTOSAR/EcucDefs/BswM/BswMConfig/BswMModeControl/BswMAction/BswMAvailableActions/BswMUserCallout</DEFINITION-REF>
                                                            <PARAMETER-VALUES>
                                                                <ECUC-TEXTUAL-PARAM-VALUE>
                                                                    <IMPORT>NONE</IMPORT>
                                                                    <DEFINITION-REF DEST="ECUC-STRING-PARAM-DEF">/AUTOSAR/EcucDefs/BswM/BswMConfig/BswMModeControl/BswMAction/BswMAvailableActions/BswMUserCallout/BswMUserCalloutFunction</DEFINITION-REF>
                                                                    <VALUE>void BswM_Init_Nvm_Read_All(void)</VALUE>
                                                                </ECUC-TEXTUAL-PARAM-VALUE>
                                                                <ECUC-TEXTUAL-PARAM-VALUE>
                                                                    <IMPORT>NONE</IMPORT>
                                                                    <DEFINITION-REF DEST="ECUC-STRINGTEXT-PARAM-DEF">/AUTOSAR/EcucDefs/BswM/BswMConfig/BswMModeControl/BswMAction/BswMAvailableActions/BswMUserCallout/BswMUserCode</DEFINITION-REF>
                                                                    <VALUE>{/n  NvM_ReadAll();/n  while((BswM_NvMJobState[0] == NVM_REQ_PENDING))/n  {/n	NvM_MainFunction();/n	Fee_MainFunction();/n	Fls_MainFunction();/n  }/n  memcpy(0x51800000, &amp;dsm_nvm_data[0], 0x8000);/n}</VALUE>
                                                                </ECUC-TEXTUAL-PARAM-VALUE>
                                                                <ECUC-TEXTUAL-PARAM-VALUE>
                                                                    <IMPORT>NONE</IMPORT>
                                                                    <DEFINITION-REF DEST="ECUC-STRING-PARAM-DEF">/AUTOSAR/EcucDefs/BswM/BswMConfig/BswMModeControl/BswMAction/BswMAvailableActions/BswMUserCallout/BswMHeaderFile</DEFINITION-REF>
                                                                    <VALUE>string.h</VALUE>
                                                                </ECUC-TEXTUAL-PARAM-VALUE>
                                                            </PARAMETER-VALUES>
                                                        </ECUC-CONTAINER-VALUE>

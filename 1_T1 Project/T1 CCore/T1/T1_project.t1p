          <LayerConfig>
            <Name>pure T1</Name>
            <RoutingParameters xmlns:q1="Gliwa-CommunicationConfig" xsi:type="q1:GcpRoutingParameterType">
              <AppId>0</AppId>
              <TargetId>2</TargetId>
            </RoutingParameters>
            <BusRoutingParameter xmlns:q2="Gliwa-CommunicationConfig" xsi:type="q2:CanRoutingParameterType">

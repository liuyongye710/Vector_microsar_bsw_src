;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Configurations for Core 4
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
#system 4:
-systemName=Core4                               ; any system name being displayed in T1.base menu in T1-HOST-SW
-systemComment=Core4                            ; any system comment
-osBasicSchedFrameName=Task_100ms_Core4         ; basicSchedulingFrameEvent: OS-name of periodic task containing the main control or calculations of the system
-osBackgroundTaskName=Idle_Task_Core4           ; task to be excluded from T1.cont and T1.scope CPU-load calculation [OS-name] [optional]
-traceBufferEntries=1000                        ; trace buffer entries

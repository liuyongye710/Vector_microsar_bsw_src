;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
#system 3:
-systemName=Core3                               ; any system name being displayed in T1.base menu in T1-HOST-SW
-systemComment=Core3                            ; any system comment
-osBasicSchedFrameName=Task_100ms_Core3         ; basicSchedulingFrameEvent: OS-name of periodic task containing the main control or calculations of the system
-osBackgroundTaskName=Idle_Task_Core3           ; task to be excluded from T1.cont and T1.scope CPU-load calculation [OS-name] [optional]
-traceBufferEntries=1000                        ; trace buffer entries
; -flexAnalysisCapacity=2000                    ; maximum allowed number of T1.flex exception handler calls between two T1_Handler calls.
-cpuLoadThreshold=95                            ; CPU-load threshold for T1.cont CPU-load callback [0..99]

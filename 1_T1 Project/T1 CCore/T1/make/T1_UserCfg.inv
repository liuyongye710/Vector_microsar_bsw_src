-systemComment=Core2                            ; any system comment
-osBasicSchedFrameName=Task_20ms_Core2_QM         ; basicSchedulingFrameEvent: OS-name of periodic task containing the main control or calculations of the system
-osBackgroundTaskName=Idle_Task_Core2           ; task to be excluded from T1.cont and T1.scope CPU-load calculation [OS-name] [optional]
-traceBufferEntries=4000                        ; trace buffer entries
; -flexAnalysisCapacity=2000                    ; maximum allowed number of T1.flex exception handler calls between two T1_Handler calls.
-cpuLoadThreshold=95                            ; CPU-load threshold for T1.cont CPU-load callback [0..99]
-numberOfConstraints=2                          ; number of T1.cont constraints

; Allocate Delays for Core 
; -allocateDL=RUNNABLE_0, "Runnable 0 Core 2", 100us

; Allocate User Events for Core 2
; -allocateUE=BSF, "Basic Scheduling Frame Core 2"

; Allocate User Stopwatches for Core 2

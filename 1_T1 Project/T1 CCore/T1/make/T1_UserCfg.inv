;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
#system 5:
-systemName=Core5                               ; any system name being displayed in T1.base menu in T1-HOST-SW
-systemComment=Core5                            ; any system comment
-osBasicSchedFrameName=Task_100ms_Core5         ; basicSchedulingFrameEvent: OS-name of periodic task containing the main control or calculations of the system
-osBackgroundTaskName=Idle_Task_Core5           ; task to be excluded from T1.cont and T1.scope CPU-load calculation [OS-name] [optional]
